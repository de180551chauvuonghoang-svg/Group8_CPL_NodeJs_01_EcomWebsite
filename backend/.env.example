PORT=5000
ACCESS_TOKEN_SECRET=your_access_token_secret_key_here
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Seed password for initial dev users (admin@ecom.com, customer@ecom.com).
# In development: defaults to 'password123' if not set.
# In production: MUST be set explicitly — seeding is skipped if NODE_ENV=production.
SEED_PASSWORD=password123

DB_USER=sa
DB_PASSWORD=123456789
DB_SERVER=localhost
DB_DATABASE=ecomfpt
DB_INSTANCE=SQLEXPRESS

# ─── Cloudinary (ảnh upload) — để trống, upload ảnh sẽ lỗi tới khi điền thật ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Google OAuth — để trống, đăng nhập Google sẽ lỗi tới khi điền thật ──────
GOOGLE_CLIENT_ID=your_google_client_id

# ─── Email (OTP quên mật khẩu) — để trống sẽ tự log OTP ra console thay vì gửi mail ─
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password

# ─── MoMo Payment Gateway ────────────────────────────────────────────────────
# Lấy từ cổng thông tin MoMo Business: https://business.momo.vn
# SANDBOX (test): MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# PRODUCTION:     MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=your_partner_code
MOMO_ACCESS_KEY=your_access_key
MOMO_SECRET_KEY=your_secret_key
MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
# URL mà MoMo redirect người dùng về sau khi thanh toán (domain production)
MOMO_REDIRECT_URL=https://yourdomain.com/payment/return
# URL webhook IPN — MoMo gọi server-to-server (phải là URL công khai, không dùng localhost)
MOMO_IPN_URL=https://yourdomain.com/api/payments/momo/ipn